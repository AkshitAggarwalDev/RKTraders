# ===================================================================
# RK Traders — Environment variables (example file)
# ===================================================================
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
# Backend reads this from the repo root; frontend has its own copy in frontend/.

# -------------------------------------------------------------------
# Database — MySQL (local development, unchanged)
# -------------------------------------------------------------------
# Used when running WITHOUT the postgres profile.
DB_URL=jdbc:mysql://localhost:3306/rktraders?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your-local-mysql-password

# -------------------------------------------------------------------
# Database — PostgreSQL (Supabase, production target)
# -------------------------------------------------------------------
# Used when the backend runs with the `postgres` profile
# (SPRING_PROFILES_ACTIVE=postgres).
#
# DIRECT connection (works from Railway in most cases):
#   DB_URL=jdbc:postgresql://db.tzwmraagnoiuwbcdkhim.supabase.co:5432/postgres?ssl=true&sslmode=require
#   DB_USERNAME=postgres
#
# SESSION POOLER (IPv4-friendly; use if the direct host is unreachable):
#   DB_URL=jdbc:postgresql://aws-0-<REGION>.pooler.supabase.com:5432/postgres?ssl=true&sslmode=require
#   DB_USERNAME=postgres.tzwmraagnoiuwbcdkhim
# Copy the exact pooler host/username from Supabase → Project Settings →
# Database → Connection string.
#
# The password is supplied via DB_PASSWORD; NEVER commit it.
DB_URL=jdbc:postgresql://db.tzwmraagnoiuwbcdkhim.supabase.co:5432/postgres?ssl=true&sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=

# -------------------------------------------------------------------
# JPA / Hibernate
# -------------------------------------------------------------------
# `update` lets Hibernate create missing tables/columns at startup — this is
# the schema-creation mechanism for a fresh Supabase database. Use `validate`
# as a hardening step after the first successful boot.
JPA_DDL_AUTO=update

# -------------------------------------------------------------------
# JWT
# -------------------------------------------------------------------
# Set a long random string; never reuse a placeholder in production.
JWT_SECRET=
JWT_EXPIRATION=3600000

# -------------------------------------------------------------------
# Owner (auto-created/updated at startup by existing logic)
# -------------------------------------------------------------------
OWNER_NAME=
OWNER_EMAIL=
OWNER_PASSWORD=

# -------------------------------------------------------------------
# Product image / upload storage
# -------------------------------------------------------------------
FILE_UPLOAD_DIR=uploads

# -------------------------------------------------------------------
# CORS
# -------------------------------------------------------------------
# Comma-separated list of browser origins allowed to call the backend.
# For production: CORS_ALLOWED_ORIGINS=https://<your-app>.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -------------------------------------------------------------------
# Frontend (Next.js) — production API base URL  (see frontend/.env.example)
# -------------------------------------------------------------------
# NEXT_PUBLIC_API_BASE_URL=https://<your-backend>.up.railway.app
